  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default paper slip button; presses into its shadow.",
      "html": "<button class=\"ds-btn\">Copy link</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:.5rem 1rem;font-family:var(--font-body);font-weight:700;line-height:1.2;color:var(--ink);background:var(--surface);border:2px solid var(--ink);border-radius:2px;box-shadow:2px 2px 0 var(--ink);cursor:pointer;transition:transform 80ms cubic-bezier(.2,.8,.2,1),box-shadow 80ms cubic-bezier(.2,.8,.2,1),background-color 120ms}.ds-btn:hover{background:var(--blue-tint)}.ds-btn:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--ink)}.ds-btn:focus-visible{outline:3px solid var(--blue);outline-offset:3px}"
    },
    {
      "name": "Primary Button (big)",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single main action of a screen.",
      "html": "<button class=\"ds-btn-primary\">Start game</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:.75rem 1.4rem;font-family:var(--font-body);font-size:1.125rem;font-weight:700;color:var(--surface);background:var(--blue);border:2px solid var(--ink);border-radius:2px;box-shadow:4px 4px 0 var(--ink);cursor:pointer;transition:transform 80ms cubic-bezier(.2,.8,.2,1),box-shadow 80ms cubic-bezier(.2,.8,.2,1)}.ds-btn-primary:hover{background:#173fb0}.ds-btn-primary:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--ink)}.ds-btn-primary:focus-visible{outline:3px solid var(--blue);outline-offset:3px}"
    },
    {
      "name": "Judge Buttons",
      "kind": "button",
      "refersTo": "button-good",
      "description": "Host Correct / Incorrect with keyboard hints.",
      "html": "<div style=\"display:flex;gap:.75rem\"><button class=\"ds-judge ds-judge--good\">Correct +600 <kbd class=\"ds-kbd\">C</kbd></button><button class=\"ds-judge ds-judge--bad\">Incorrect −600 <kbd class=\"ds-kbd\">X</kbd></button></div>",
      "css": ".ds-judge{display:inline-flex;align-items:center;gap:.5em;min-height:56px;padding:.75rem 1.4rem;font-family:var(--font-body);font-size:1.125rem;font-weight:700;color:var(--surface);border:2px solid var(--ink);border-radius:2px;box-shadow:4px 4px 0 var(--ink);cursor:pointer}.ds-judge--good{background:var(--good)}.ds-judge--good:hover{background:#17562e}.ds-judge--bad{background:var(--bad)}.ds-judge--bad:hover{background:#8a1f15}.ds-judge:active{transform:translate(2px,2px);box-shadow:none}.ds-judge:focus-visible{outline:3px solid var(--blue);outline-offset:3px}.ds-kbd{min-width:1.5em;padding:0 .35em;font-size:.75em;border:1.5px solid currentColor;border-bottom-width:3px;border-radius:2px;opacity:.85}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled input with hint.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field__label\">Room code</span><input class=\"ds-input\" placeholder=\"BCDFG\"><span class=\"ds-field__hint\">5 letters, no vowels</span></label>",
      "css": ".ds-field{display:grid;gap:.35rem;font-family:var(--font-body)}.ds-field__label{font-size:.875rem;font-weight:700}.ds-field__hint{font-size:.8125rem;color:var(--muted)}.ds-input{min-height:44px;padding:.5rem .7rem;color:var(--ink);background:var(--surface);border:2px solid var(--ink);border-radius:2px;font:inherit}.ds-input:focus-visible{outline:3px solid var(--blue);outline-offset:3px}.ds-input[aria-invalid=true]{border-color:var(--bad);box-shadow:inset 0 0 0 1px var(--bad)}"
    },
