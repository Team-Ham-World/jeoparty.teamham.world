      "css": ".ds-stamp{display:inline-flex;align-items:center;padding:.12em .55em;font-family:var(--font-body);font-size:.8125rem;font-weight:700;line-height:1.35;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);border:2px solid currentColor;border-radius:2px;transform:rotate(-2deg)}.ds-stamp--good{color:var(--surface);background:var(--good);border-color:var(--good)}.ds-stamp--hot{background:var(--hot);border-color:var(--ink)}.ds-stamp--dashed{border-style:dashed;color:var(--muted)}.ds-stamp--red{border-color:var(--red);box-shadow:0 0 0 2px var(--surface),0 0 0 4px var(--red);margin:4px}"
